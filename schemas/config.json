{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jongleberry/supervisor/schemas/config.json",
  "title": "supervisor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["scopes", "provenance", "mergeAuthority", "finalReview", "harness"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "kind", "repos"],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["org", "user"]
          },
          "repos": {
            "oneOf": [
              {
                "const": "*"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "excludeForks": {
            "type": "boolean"
          },
          "excludedRepos": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mode": {
            "type": "string",
            "enum": ["enforce", "report"]
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "taxonomy": {
            "type": "object",
            "properties": {
              "projectByRepo": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sensitiveIssueRepo": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "checkoutRoot": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "mergeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "policyEngine", "attendedOnly", "hosts", "models"],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "policyEngine": {
          "type": "string",
          "enum": ["supervisor", "claude-approvals", "compare"]
        },
        "attendedOnly": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredAlwaysHuman": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "samples"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "samples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "finalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["session", "label"]
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "trustedLogins": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stateDir": {
      "type": "string",
      "minLength": 1
    },
    "modelTiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mechanical": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automation": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Ignored; Phase B and default PR triage select open PRs by their provenance comment instead of a label."
        },
        "needsHuman": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "escalationChannel": {
      "type": "string",
      "minLength": 1
    },
    "dependencyBot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "openPullRequestLimit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lockfileDedupe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dispatchTargets": {
      "type": "object"
    },
    "fallbackCron": {
      "type": "string",
      "minLength": 1,
      "default": "0 */6 * * *"
    },
    "lateReviewDays": {
      "type": "number",
      "minimum": 0,
      "default": 14
    },
    "fullRescanDays": {
      "type": "number",
      "minimum": 0,
      "default": 7
    },
    "layerCap": {
      "type": "number",
      "minimum": 0,
      "default": 10
    },
    "sweepCap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "integer",
          "minimum": 0,
          "default": 10
        },
        "dispatches": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        }
      }
    },
    "scheduledPrompts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "prWrapper": {
          "type": "string",
          "minLength": 1
        },
        "issueWrapper": {
          "type": "string",
          "minLength": 1
        },
        "issueMarker": {
          "type": "string",
          "minLength": 1
        },
        "quota": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "history": {
          "type": "integer",
          "minimum": 0,
          "default": 20,
          "description": "Number of completed scheduled-prompt runs to retain in state; must be >= quota (checked when the config is validated or loaded)."
        }
      }
    },
    "staleRuns": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "olderThan": {
              "type": "string",
              "minLength": 1
            },
            "cancelAfter": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "eventWait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hookHarness": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Ignored; supervisor reads relay events with its bundled hook-harness client."
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+[smhd]?$",
          "default": "2h"
        },
        "advance": {
          "type": "boolean",
          "default": false
        },
        "updateCheckDelay": {
          "type": "string",
          "pattern": "^[0-9]+[smhd]?$",
          "default": "10m"
        }
      }
    },
    "distill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retroDays": {
          "type": "number",
          "minimum": 0
        },
        "sessionDays": {
          "type": "number",
          "minimum": 0
        },
        "archive": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
