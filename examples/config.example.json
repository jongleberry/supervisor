{
  "$schema": "../schemas/config.json",
  "scopes": [
    {
      "owner": "example-org",
      "kind": "org",
      "repos": "*",
      "excludeForks": true,
      "excludedRepos": ["archived-repo"],
      "mode": "enforce",
      "provenance": {
        "fields": ["agent", "model", "session"]
      },
      "taxonomy": {
        "projectByRepo": {
          "example-repo": "Example project"
        },
        "sensitiveIssueRepo": "example-private-issues"
      },
      "checkoutRoot": "~/code/example-org"
    },
    {
      "owner": "example-user",
      "kind": "user",
      "repos": ["demo-repo"],
      "mode": "report"
    }
  ],
  "provenance": {
    "fields": ["agent", "model"]
  },
  "mergeAuthority": {
    "policy": "./merge-policy.json",
    "policyEngine": "supervisor",
    "attendedOnly": true,
    "hosts": ["workstation-1"],
    "models": ["claude-sonnet", "gpt-5"]
  },
  "finalReview": {
    "request": ["session", "label"],
    "label": "ready-for-review",
    "reviewer": "bot:example-reviewer",
    "status": "review-status"
  },
  "harness": "claude-code",
  "trustedLogins": ["example-user"],
  "stateDir": "~/.supervisor-state",
  "modelTiers": {
    "mechanical": "fast model, medium effort",
    "implementation": "balanced model, medium effort",
    "review": "strongest model"
  },
  "labels": {
    "needsHuman": "needs-human"
  },
  "escalationChannel": "push notification",
  "dependencyBot": {
    "author": "app/dependabot",
    "openPullRequestLimit": 5
  },
  "lockfileDedupe": {
    "author": "app/github-actions",
    "branch": "chore/pnpm-dedupe",
    "workflow": "pnpm-dedupe.yml"
  },
  "dispatchTargets": {
    "workspaceAgents": "list and prompt agents through the terminal multiplexer"
  },
  "fallbackCron": "0 */6 * * *",
  "lateReviewDays": 14,
  "fullRescanDays": 7,
  "layerCap": 10,
  "sweepCap": {
    "issues": 10,
    "dispatches": 5
  },
  "scheduledPrompts": {
    "glob": "docs/prompts/scheduled/*.md",
    "prWrapper": "docs/prompts/automation/scheduled-prompt.md",
    "issueWrapper": "docs/prompts/automation/scheduled-issue.md",
    "issueMarker": "scheduled-completion: issue",
    "quota": 1,
    "history": 20
  },
  "staleRuns": {
    "olderThan": "6h",
    "cancelAfter": "24h"
  },
  "eventWait": {
    "timeout": "2h",
    "advance": false,
    "updateCheckDelay": "10m"
  },
  "distill": {
    "sessionDays": 7,
    "archive": true
  }
}
